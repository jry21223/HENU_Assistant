+def extract_qq_c2c_quote_ref_idx(event_type: Any, data: Any) -> Optional[str]:
+    """Keep one unambiguous QQ server quote index from a C2C type-103 event."""
+    if event_type != 'C2C_MESSAGE_CREATE' or not isinstance(data, dict):
+        return None
+    if type(data.get('message_type')) is not int or data['message_type'] != 103:
+        return None
+
+    def valid_ref_idx(value: Any) -> bool:
+        return (
+            isinstance(value, str)
+            and 0 < len(value) <= 256
+            and all(33 <= ord(character) <= 126 for character in value)
+        )
+
+    scene = data.get('message_scene')
+    if scene is not None and not isinstance(scene, dict):
+        return None
+    ext = scene.get('ext') if isinstance(scene, dict) else None
+    if ext is not None and (not isinstance(ext, list) or len(ext) > 32):
+        return None
+    ext_indices: dict[str, str] = {}
+    for entry in ext or []:
+        if not isinstance(entry, str) or len(entry) > 512:
+            return None
+        for name in ('ref_msg_idx', 'msg_idx'):
+            prefix = name + '='
+            if entry.startswith(prefix):
+                value = entry[len(prefix):]
+                if name in ext_indices or not valid_ref_idx(value):
+                    return None
+                ext_indices[name] = value
+                break
+
+    elements = data.get('msg_elements')
+    if elements is not None and (not isinstance(elements, list) or len(elements) > 32):
+        return None
+    element_index = None
+    for element in elements or []:
+        if not isinstance(element, dict):
+            return None
+        if 'msg_idx' in element:
+            value = element['msg_idx']
+            if element_index is not None or not valid_ref_idx(value):
+                return None
+            element_index = value
+
+    indices = [*ext_indices.values()]
+    if element_index is not None:
+        indices.append(element_index)
+    if not indices or any(index != indices[0] for index in indices[1:]):
+        return None
+    return indices[0]
 
 
