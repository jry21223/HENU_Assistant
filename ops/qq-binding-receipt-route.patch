+class QQFriendMessage(platform_events.FriendMessage):
+    """Carry only verified WebSocket C2C provenance across the first SDK boundary."""
+
+    def model_dump(self, **kwargs):
+        result = super().model_dump(**kwargs)
+        result.pop('source_platform_object', None)
+        source = self.source_platform_object
+        if not isinstance(source, dict) or source.get('t') != 'C2C_MESSAGE_CREATE':
+            return result
+        if source.get('qq_websocket_verified') is not True:
+            return result
+        message_id = source.get('d_id')
+        if not isinstance(message_id, str) or not (0 < len(message_id) <= 256):
+            return result
+        if not all(33 <= ord(character) <= 126 for character in message_id):
+            return result
+        if not self.message_chain or type(self.message_chain[0]) is not platform_message.Source:
+            return result
+        if self.message_chain[0].id != message_id:
+            return result
+        marker = {
+            't': 'C2C_MESSAGE_CREATE',
+            'd_id': message_id,
+            'qq_websocket_verified': True,
+        }
+        if 'qq_quote_present' in source:
+            if source['qq_quote_present'] is not True:
+                return result
+            marker['qq_quote_present'] = True
+            if 'qq_quote_ref_idx' in source:
+                ref_idx = source['qq_quote_ref_idx']
+                if (
+                    isinstance(ref_idx, str)
+                    and 0 < len(ref_idx) <= 256
+                    and all(33 <= ord(character) <= 126 for character in ref_idx)
+                ):
+                    marker['qq_quote_ref_idx'] = ref_idx
+        result['source_platform_object'] = marker
+        return result
 
 
