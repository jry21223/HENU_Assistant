# Copy this file to .env for local LangBot plugin debugging.
DEBUG_RUNTIME_WS_URL=ws://127.0.0.1:5401/debug/ws

# Plugin debug key for runtime authentication. Leave empty to disable.
PLUGIN_DEBUG_KEY=

# Stable credential encryption master key. Required for production and container
# deployments. Use a long random value and keep it unchanged across restarts.
HENU_MASTER_KEY=

# yuketang daemon bridge (server B). Optional: without these the yuketang config
# commands still succeed locally; the daemon syncs on the next reachable status check.
# HTTPS endpoint terminated by nginx on B (Let's Encrypt). Traffic additionally uses
# AES-256-GCM sealed envelopes; SECRET must equal config.json bridge.secret on B.
HENU_BRIDGE_URL=
HENU_BRIDGE_SECRET=
